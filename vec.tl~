local record Vector2
x: number
y: number
end

function Vector2.add(v: Vector2 ) : Vector2
   local self: Vector2 = setmetatable({}, { __index = Vector2 })
   self.x = self.x + v.x or 0
   self.y = self.y + v.y or 0
   return {x = self.x, y = self.y}
end


function Vector2.minus(v: Vector2) : Vector2
   local self: Vector2 = setmetatable({}, { __index = Vector2 })
   self.x = self.x - v.x or 0
   self.y = self.y - v.y or 0
   return {x = self.x, y = self.y}
end


function Vector2.mull(v: Vector2) : Vector2
   local self: Vector2 = setmetatable({}, { __index = Vector2 })
   self.x = self.x * v.x or 0
   self.y = self.y * v.y or 0
   return {x = self.x, y = self.y}
end


function Vector2.div(v: Vector2) : Vector2
   local self: Vector2 = setmetatable({}, { __index = Vector2 })
   self.x = self.x / v.x or 0
   self.y = self.y / v.y or 0
   return {x = self.x, y = self.y}
end

